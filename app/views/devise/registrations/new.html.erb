<div class="min-h-screen flex items-center justify-center bg-gray-50">

  <div class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8">

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="mx-auto w-12 h-12 flex items-center justify-center rounded-xl bg-primary mb-3">
        <%= inline_svg_tag "icons/user-plus.svg", class: "w-6 h-6 text-white" %>
      </div>

      <h2 class="text-2xl font-bold text-gray-900">Create your account</h2>
      <p class="text-sm text-gray-500 mt-1">Sign up to get started</p>
    </div>

    <!-- GOOGLE BUTTON (UI ONLY) -->
    <button
      type="button"
      class="w-full flex items-center justify-center gap-3 border border-gray-300 rounded-xl h-12 font-medium hover:bg-gray-50 transition"
    >
      <%= inline_svg_tag "icons/google.svg", class: "w-5 h-5" %>
      Continue with Google
    </button>

    <!-- Divider -->
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-200"></div>
      </div>
      <div class="relative flex justify-center text-xs uppercase">
        <span class="bg-white px-3 text-gray-400">or</span>
      </div>
    </div>

    <!-- ERRORS -->
    <% if resource.errors.any? %>
      <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-600 text-sm">
        <%= render "devise/shared/error_messages", resource: resource %>
      </div>
    <% end %>

    <!-- FORM -->
    <%= form_with model: resource,
              as: resource_name,
              url: registration_path(resource_name),
              local: true,
              data: { turbo: false } do |f| %>

      <!-- EMAIL -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>

        <div class="relative">
          <div class="absolute left-3 top-1/2 -translate-y-1/2">
            <%= inline_svg_tag "icons/mail.svg", class: "w-4 h-4 text-gray-400" %>
          </div>

          <%= f.email_field :email,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full h-12 pl-10 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <!-- PASSWORD -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>

        <div class="relative">
          <div class="absolute left-3 top-1/2 -translate-y-1/2">
            <%= inline_svg_tag "icons/lock.svg", class: "w-4 h-4 text-gray-400" %>
          </div>

          <%= f.password_field :password,
            autocomplete: "new-password",
            placeholder: "••••••••",
            class: "w-full h-12 pl-10 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <!-- CONFIRM PASSWORD -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>

        <div class="relative">
          <div class="absolute left-3 top-1/2 -translate-y-1/2">
            <%= inline_svg_tag "icons/lock.svg", class: "w-4 h-4 text-gray-400" %>
          </div>

          <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "••••••••",
            class: "w-full h-12 pl-10 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <!-- SUBMIT -->
      <%= f.submit "Create account",
        class: "w-full h-12 bg-primary hover:bg-accent-foreground text-white font-medium rounded-xl transition" %>

    <% end %>

    <!-- FOOTER -->
    <p class="text-center text-sm text-gray-500 mt-6">
      Already have an account?
      <%= link_to "Log in", new_user_session_path, class: "text-indigo-600 font-medium hover:underline" %>
    </p>

  </div>
</div>