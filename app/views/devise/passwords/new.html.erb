<div class="min-h-screen flex items-center justify-center bg-gray-50">

  <div class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8">

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="mx-auto w-12 h-12 flex items-center justify-center rounded-xl bg-primary mb-3">
        <%= inline_svg_tag "icons/mail.svg", class: "w-6 h-6 text-white" %>
      </div>

      <h2 class="text-2xl font-bold text-gray-900">Forgot password?</h2>
      <p class="text-sm text-gray-500 mt-1">
        Enter your email to receive a reset link
      </p>
    </div>

    <!-- ERRORS -->
    <% if resource.errors.any? %>
      <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-600 text-sm">
        <%= render "devise/shared/error_messages", resource: resource %>
      </div>
    <% end %>

    <!-- FORM -->
    <%= form_with model: resource,
                  as: resource_name,
                  url: password_path(resource_name),
                  local: true,
                  data: { turbo: false } do |f| %>

      <!-- EMAIL -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Email
        </label>

        <div class="relative">
          <div class="absolute left-3 top-1/2 -translate-y-1/2">
            <%= inline_svg_tag "icons/mail.svg", class: "w-4 h-4 text-gray-400" %>
          </div>

          <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full h-12 pl-10 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <!-- SUBMIT -->
      <%= f.submit "Send reset link",
        class: "w-full h-12 bg-primary hover:bg-accent-foreground text-white font-medium rounded-xl transition" %>

    <% end %>

    <!-- FOOTER -->
    <p class="text-center text-sm text-gray-500 mt-6">
      Remember your password?
      <%= link_to "Sign in",
          new_user_session_path,
          class: "text-primary font-medium hover:underline" %>
    </p>

  </div>
</div>